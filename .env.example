# PostgreSQL/PostGIS connection. Do not add real credentials to this file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# The current hosted database uses a self-signed certificate chain. TLS remains
# enabled, but certificate-chain validation is off for compatibility. Set this
# to true only after configuring a database endpoint with a trusted CA.
# POSTGRES_SSL_REJECT_UNAUTHORIZED=true

# Optional map and public-site configuration.
# NEXT_PUBLIC_MAPTILER_KEY=
# NEXT_PUBLIC_SITE_URL=https://www.findfreeparking.info
# NEXT_PUBLIC_GA_ID=

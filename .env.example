# PostgreSQL/PostGIS connection. Do not add real credentials to this file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# The configured hosted database uses a self-signed certificate chain. TLS is
# enabled by the application with compatible certificate handling; do not add
# sslmode or other ssl* query parameters to this URL.


# PostgreSQL/PostGIS connection. Do not add real credentials to this file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# TLS certificates are verified by default. Uncomment only for a trusted local
# development database that uses a self-signed certificate.
# POSTGRES_SSL_REJECT_UNAUTHORIZED=false

# Optional map and public-site configuration.
# NEXT_PUBLIC_MAPTILER_KEY=
# NEXT_PUBLIC_SITE_URL=https://www.findfreeparking.info
# NEXT_PUBLIC_GA_ID=
